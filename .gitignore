# Entorno local y archivos temporales
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
Thumbs.db

# Configuración personal y credenciales de Drive.
config/captura_local.json
**/*client_secret*.json
**/*credentials*.json
**/*drive_token.json

# No publicar datos hasta verificar procedencia y licencia.
datos/raw/*
!datos/raw/.gitkeep
!datos/raw/README.md
datos/procesados/*
!datos/procesados/.gitkeep

# Resultados generados: se regeneran desde el código.
outputs/*
!outputs/.gitkeep
